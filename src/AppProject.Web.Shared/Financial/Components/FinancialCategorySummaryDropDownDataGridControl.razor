@using AppProject.Web.ApiClient.Financial
@using AppProject.Web.Models.Financial

@inherits AppProjectComponentBase

@typeparam TValue

<DropDownDataGridControl TValue="TValue" Name=@this.Name Data=@this.FinancialCategorySummaries LoadData=@this.LoadFinancialCategoriesAsync
    Value=@this.Value ValueChanged=@this.OnValueChangedAsync
    TextProperty=@nameof(FinancialCategorySummary.Name) ValueProperty=@nameof(FinancialCategorySummary.Id)>
    <Columns>
        <RadzenDropDownDataGridColumn Property=@nameof(FinancialCategorySummary.Name) Title=@StringResource.GetStringByKey("Financial_FinancialCategorySummaryDropDownDataGridControl_NameColumn_Title") />
    </Columns>
</DropDownDataGridControl>

@code {
    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    [Inject]
    private IFinancialCategorySummaryClient FinancialCategorySummaryClient { get; set; } = default!;

    private IEnumerable<FinancialCategorySummary> FinancialCategorySummaries { get; set; } = default!;

    private async Task LoadFinancialCategoriesAsync(LoadDataArgs args)
    {
        var summariesResponse = await this.GetResultOrHandleExceptionAsync<SummariesResponse<FinancialCategorySummary>>(
            async () =>
            {
                var summariesResponse = await this.FinancialCategorySummaryClient.GetSummariesAsync(new SearchRequest() { SearchText = args.Filter, Take = 100 });

                if (string.IsNullOrWhiteSpace(args.Filter)
                    && this.Value is Guid selectedGuid
                    && selectedGuid != Guid.Empty
                    && summariesResponse?.Summaries.Any(x => x.Id == selectedGuid) == false)
                {
                    var selectedSummaryResponse = await this.FinancialCategorySummaryClient.GetSummaryAsync(new GetByIdRequest<Guid> { Id = selectedGuid });

                    if (selectedSummaryResponse?.Summary != null)
                    {
                        return new SummariesResponse<FinancialCategorySummary>
                        {
                            Summaries = summariesResponse.Summaries.Concat([selectedSummaryResponse.Summary])
                                .OrderBy(x => x.Name)
                                .ToArray()
                        };
                    }
                }

                return summariesResponse!;
            },
            showBusyIndicator: false);

        this.FinancialCategorySummaries = summariesResponse?.Summaries ?? Enumerable.Empty<FinancialCategorySummary>();
    }

    private async Task OnValueChangedAsync(TValue value)
    {
        if (!EqualityComparer<TValue>.Default.Equals(this.Value, value))
        {
            this.Value = value;

            if (this.ValueChanged.HasDelegate)
            {
                await this.ValueChanged.InvokeAsync(value);
            }
        }
    }
}
